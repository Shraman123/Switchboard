{
  "name": "switchboard-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team MCP gateway: MCP client to every registered upstream, MCP server to every team member, plus the dashboard API and chat agent",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
